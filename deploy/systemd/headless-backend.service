[Unit]
Description=Headless Backend
Documentation=https://github.com/fastygo/backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=headless
Group=headless
EnvironmentFile=/etc/headless-backend/backend.env
ExecStart=/usr/local/bin/headless-backend
WorkingDirectory=/var/lib/headless-backend
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
ReadWritePaths=/var/lib/headless-backend

[Install]
WantedBy=multi-user.target
