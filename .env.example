APP_BIND=0.0.0.0:8080
APP_DEFAULT_LOCALE=en
APP_AVAILABLE_LOCALES=en,ru
HEALTH_LIVE_PATH=/healthz
HEALTH_READY_PATH=/readyz
METRICS_PATH=/metrics
LOG_LEVEL=info
LOG_FORMAT=json

# bbolt, sqlite, mysql, mariadb, postgres, or postgresql
HEADLESS_STORAGE=sqlite
HEADLESS_BBOLT_PATH=./var/lib/headless/backend.db

# Required for SQLite/MySQL/MariaDB/PostgreSQL; unused by bbolt.
# SQLite example: ./var/lib/headless/backend.sqlite
# PostgreSQL example: postgres://headless:password@127.0.0.1:5432/headless?sslmode=require
# MySQL/MariaDB example: headless:password@tcp(127.0.0.1:3306)/headless?parseTime=true&charset=utf8mb4
DATABASE_URL=./var/lib/headless/backend.sqlite

HEADLESS_MANIFEST_PATH=./dev/example.manifest.json
HEADLESS_MEDIA_ROOT=./var/lib/headless/media
HEADLESS_MEDIA_MAX_BYTES=33554432
HEADLESS_SCHEDULE_INTERVAL=1m

# Generate with: openssl rand -base64 48
HEADLESS_TOKEN_SECRET=replace-with-at-least-32-random-bytes
HEADLESS_TOKEN_ISSUER=headless-backend
# Used only when the user store is empty; remove after the first successful startup.
HEADLESS_ADMIN_EMAIL=admin@example.test
HEADLESS_ADMIN_PASSWORD=admin-local-dev
HEADLESS_COOKIE_SECURE=false
# Local read-only development only. Never enable in production.
HEADLESS_ALLOW_INSECURE_AUTH=false

HEADLESS_PORT=8080
POSTGRES_PASSWORD=replace-me
MYSQL_PASSWORD=replace-me
MYSQL_ROOT_PASSWORD=replace-me-too
MARIADB_PASSWORD=replace-me
MARIADB_ROOT_PASSWORD=replace-me-too
